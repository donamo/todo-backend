PORT=3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=DEBUG
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s

# Optional for health-only startup. Required for GraphQL domain operations.
DATABASE_URL=postgres://todo:todo@localhost:5432/todo_backend?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:postgres@192.168.1.2:5432/todo-e2e?sslmode=disable

# Required once Google auth/session handling is enabled.
SESSION_SECRET=change-me-in-development
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/callback/google

OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT=30s
